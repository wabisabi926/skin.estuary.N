<?xml version="1.0" encoding="UTF-8"?>
<window>
	<onload condition="!Player.PauseEnabled">SetFocus(70048)</onload>
	<defaultcontrol always="true">602</defaultcontrol>
	<backgroundcolor>FF000000</backgroundcolor>
	<controls>
		<include>NaraMusicPlayerBackground</include>
		<control type="group">
			<animation effect="fade" start="0" end="100" time="260">WindowOpen</animation>
			<control type="label">
				<left>40</left>
				<top>28</top>
				<width>800</width>
				<height>36</height>
				<font>font27</font>
				<aligny>center</aligny>
				<textcolor>text_primary</textcolor>
				<label>$LOCALIZE[31000]...</label>
				<visible>!PVR.IsPlayingRadio</visible>
			</control>
			<control type="label">
				<left>40</left>
				<top>64</top>
				<width>800</width>
				<height>32</height>
				<font>font12_large</font>
				<aligny>center</aligny>
				<textcolor>text_secondary</textcolor>
				<label>$LOCALIZE[554] $INFO[Playlist.Position(music)] / $INFO[Playlist.Length(music)]</label>
				<visible>!PVR.IsPlayingRadio + Integer.IsGreater(Playlist.Length(music),0)</visible>
			</control>
			<control type="label">
				<right>40</right>
				<top>28</top>
				<width>240</width>
				<height>68</height>
				<font>font_home_clock</font>
				<textcolor>text_primary</textcolor>
				<align>right</align>
				<aligny>center</aligny>
				<label>$INFO[System.Time]</label>
			</control>
			<control type="image">
				<left>158</left>
				<top>136</top>
				<width>493</width>
				<height>493</height>
				<texture border="40" colordiffuse="60000000">overlays/shadow.png</texture>
				<visible>!String.IsEmpty(MusicPlayer.Cover) + !String.IsEqual(MusicPlayer.Cover,DefaultAlbumCover.png)</visible>
			</control>
			<control type="image">
				<left>180</left>
				<top>157</top>
				<width>450</width>
				<height>450</height>
				<aspectratio>keep</aspectratio>
				<fadetime>250</fadetime>
				<texture background="true" fallback="osd/nara/music-cover.png">$VAR[NaraMusicCoverVar]</texture>
			</control>
			<control type="label">
				<left>180</left>
				<top>730</top>
				<width>620</width>
				<height>58</height>
				<font>font45_title</font>
				<label>$INFO[Player.Title]</label>
				<scroll>true</scroll>
			</control>
			<control type="label">
				<left>180</left>
				<top>794</top>
				<width>620</width>
				<height>40</height>
				<font>font27</font>
				<textcolor>BFFFFFFF</textcolor>
				<label>$INFO[MusicPlayer.Artist]</label>
				<scroll>true</scroll>
			</control>
			<control type="label">
				<left>180</left>
				<top>840</top>
				<width>620</width>
				<height>32</height>
				<font>font12</font>
				<textcolor>80FFFFFF</textcolor>
				<label>$INFO[MusicPlayer.Album]$INFO[MusicPlayer.Year, · ]</label>
				<scroll>true</scroll>
			</control>
			<control type="fixedlist" id="420">
				<left>980</left>
			<top>135</top>
				<width>720</width>
				<height>560</height>
				<focusposition>3</focusposition>
				<movement>0</movement>
				<scrolltime tween="sine">300</scrolltime>
				<onleft>602</onleft>
				<onright>602</onright>
				<onup>420</onup>
				<ondown>420</ondown>
				<onclick>SetFocus(602)</onclick>
				<visible>String.IsEqual(Window(visualisation).Property(NaraMusic.LyricsTimed),true) + !Window.IsVisible(script-cu-lrclyrics-main.xml)</visible>
				<itemlayout width="720" height="80">
					<control type="label">
						<width>710</width>
						<height>80</height>
						<font>font27</font>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
						<textcolor>70FFFFFF</textcolor>
					</control>
				</itemlayout>
				<focusedlayout width="720" height="80">
					<control type="label">
						<width>710</width>
						<height>80</height>
						<font>font32_title</font>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
						<textcolor>$VAR[NaraMusicLyricColorVar]</textcolor>
						<scroll>true</scroll>
					</control>
				</focusedlayout>
			</control>
			<control type="textbox" id="421">
				<left>980</left>
			<top>143</top>
				<width>690</width>
				<height>552</height>
				<font>font40_title</font>
				<textcolor>CFFFFFFF</textcolor>
				<label>$INFO[Window(visualisation).Property(NaraMusic.LyricsText)]</label>
				<pagecontrol>422</pagecontrol>
				<visible>!String.IsEmpty(Window(visualisation).Property(NaraMusic.LyricsText)) + !Window.IsVisible(script-cu-lrclyrics-main.xml)</visible>
			</control>
			<control type="scrollbar" id="422">
				<left>1700</left>
				<top>143</top>
				<width>6</width>
				<height>552</height>
				<orientation>vertical</orientation>
				<onleft>602</onleft>
				<onright>602</onright>
				<visible>!String.IsEmpty(Window(visualisation).Property(NaraMusic.LyricsText)) + !Window.IsVisible(script-cu-lrclyrics-main.xml)</visible>
			</control>
			<control type="group">
				<left>980</left>
				<top>273</top>
				<visible>!String.IsEqual(Window(visualisation).Property(NaraMusic.LyricsTimed),true) + String.IsEmpty(Window(visualisation).Property(NaraMusic.LyricsText)) + !Window.IsVisible(script-cu-lrclyrics-main.xml)</visible>
				<control type="image">
					<width>56</width>
					<height>56</height>
					<texture colordiffuse="60FFFFFF">osd/nara/lyrics.png</texture>
				</control>
				<control type="label">
					<top>86</top>
					<width>720</width>
					<height>48</height>
					<font>font32</font>
					<textcolor>BFFFFFFF</textcolor>
					<label>$VAR[NaraMusicLyricsStatusVar]</label>
				</control>
				<control type="textbox">
					<top>145</top>
					<width>700</width>
					<height>96</height>
					<font>font12</font>
					<textcolor>70FFFFFF</textcolor>
					<label>$LOCALIZE[31702]</label>
					<visible>!String.IsEqual(Window(visualisation).Property(NaraMusic.LyricsLoading),true)</visible>
				</control>
			</control>
		</control>
		<control type="group">
			<visible>!Window.IsVisible(musicosd)</visible>
			<include>NaraMusicPlayerControls</include>
		</control>
	</controls>
</window>
