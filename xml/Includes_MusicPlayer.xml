						<textureradioonnofocus colordiffuse="$VAR[NaraMusicRepeatColorVar]">osd/nara/repeat-one.png</textureradioonnofocus>
						<textureradioondisabled colordiffuse="text_disabled">osd/nara/repeat-one.png</textureradioondisabled>
						<textureradiooffnofocus colordiffuse="$VAR[NaraMusicRepeatColorVar]">osd/nara/repeat.png</textureradiooffnofocus>
						<include content="NaraMusicOSDButton">
							<param name="texture" value="osd/nara/repeat.png" />
						</include>
						<label>$LOCALIZE[486]</label>
						<selected>Playlist.IsRepeatOne</selected>
						<enable>!MusicPartyMode.Enabled</enable>
						<onclick>PlayerControl(Repeat)</onclick>
					</control>
				</control>
				<control type="group">
					<include>NaraMusicOSDButtonGlass</include>
					<control type="radiobutton" id="70051">
						<onleft>70053</onleft>
						<onright>602</onright>
