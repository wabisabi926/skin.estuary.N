							<param name="texture" value="osd/nara/shuffle.png" />
						</include>
						<label>$LOCALIZE[590]</label>
						<selected>Playlist.IsRandom</selected>
						<enable>!MusicPartyMode.Enabled + Integer.IsGreater(Playlist.Length(music),1)</enable>
						<onclick>PlayerControl(Random)</onclick>
					</control>
				</control>
				<control type="group">
					<include>NaraMusicOSDButtonGlass</include>
					<control type="radiobutton" id="70053">
						<onleft>70054</onleft>
						<onright>70051</onright>
