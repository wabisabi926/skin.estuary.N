						<label>$LOCALIZE[559]</label>
						<enable>Integer.IsGreater(Playlist.Length(music),0)</enable>
						<onclick>ActivateWindow(1114)</onclick>
					</control>
				</control>
				<control type="group">
					<include>NaraMusicOSDButtonGlass</include>
					<control type="radiobutton" id="602">
						<onleft>70051</onleft>
						<onright>600</onright>
						<textureradioonfocus colordiffuse="text_primary">osd/nara/play.png</textureradioonfocus>
						<textureradioonnofocus colordiffuse="text_primary">osd/nara/play.png</textureradioonnofocus>
						<textureradioondisabled colordiffuse="text_disabled">osd/nara/play.png</textureradioondisabled>
