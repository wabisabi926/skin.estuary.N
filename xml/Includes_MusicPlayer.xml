		<textureradioonnofocus colordiffuse="text_primary">$PARAM[texture]</textureradioonnofocus>
		<textureradioofffocus colordiffuse="text_primary">$PARAM[texture]</textureradioofffocus>
		<textureradiooffnofocus colordiffuse="text_primary">$PARAM[texture]</textureradiooffnofocus>
		<textureradioondisabled colordiffuse="text_disabled">$PARAM[texture]</textureradioondisabled>
		<textureradiooffdisabled colordiffuse="text_disabled">$PARAM[texture]</textureradiooffdisabled>
		<texturefocus border="0" cornerradius="30.5" colordiffuse="glass_focus_medium">colors/white.png</texturefocus>
		<texturenofocus />
		<width>61</width>
		<height>61</height>
		<radiowidth>43</radiowidth>
		<radioheight>43</radioheight>
		<radioposx>9</radioposx>
		<radioposy>9</radioposy>
		<onup>87</onup>
		<ondown>noop</ondown>
		<font />
	</include>
	<include name="NaraMusicOSDButtonGlass">
