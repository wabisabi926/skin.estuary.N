<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<variable name="NaraMusicCoverVar">
		<value condition="String.IsEmpty(MusicPlayer.Cover) | String.IsEqual(MusicPlayer.Cover,DefaultAlbumCover.png)">osd/nara/music-cover.png</value>
		<value>$INFO[MusicPlayer.Cover]</value>
	</variable>
	<variable name="NaraMusicFanartVis">
		<value condition="System.HasAddon(script.artistslideshow) + !String.IsEmpty(Window(Visualisation).Property(ArtistSlideshow.Image))">$INFO[Window(Visualisation).Property(ArtistSlideshow.Image)]</value>
		<value condition="!String.IsEmpty(Player.Art(fanart))">$INFO[Player.Art(fanart)]</value>
		<value>osd/nara/music-background.png</value>
	</variable>
	<variable name="NaraMusicMuteLabelVar">
		<value condition="Player.Muted">$LOCALIZE[16041]</value>
		<value>$LOCALIZE[16039]</value>
	</variable>
	<variable name="NaraMusicProgressColorVar">
		<value condition="Control.HasFocus(87) | Player.Seeking">FFFFFFFF</value>
		<value>90FFFFFF</value>
	</variable>
	<variable name="NaraMusicNibColorVar">
		<value condition="Control.HasFocus(87) | Player.Seeking">FFFFFFFF</value>
		<value>FF8C8C8C</value>
	</variable>
	<variable name="NaraMusicRepeatColorVar">
		<value condition="Playlist.IsRepeat">FFFFFFFF</value>
		<value>80FFFFFF</value>
	</variable>
	<variable name="NaraMusicShuffleColorVar">
		<value condition="Playlist.IsRandom">FFFFFFFF</value>
		<value>80FFFFFF</value>
	</variable>
	<variable name="NaraMusicLyricColorVar">
		<value condition="String.IsEqual(Window(visualisation).Property(NaraMusic.LyricsStarted),true)">FFFFFFFF</value>
		<value>70FFFFFF</value>
	</variable>
	<variable name="NaraMusicLyricsStatusVar">
		<value condition="String.IsEqual(Window(visualisation).Property(NaraMusic.LyricsLoading),true)">$LOCALIZE[31700]</value>
		<value>$LOCALIZE[31701]</value>
	</variable>
	<variable name="NaraMusicControlLabelVar">
		<value condition="Control.HasFocus(600)">$LOCALIZE[210]</value>
		<value condition="Control.HasFocus(607)">$LOCALIZE[209]</value>
		<value condition="Control.HasFocus(602) + Player.Paused">$LOCALIZE[208]</value>
		<value condition="Control.HasFocus(602)">$LOCALIZE[36045]</value>
		<value condition="Control.HasFocus(70048)">$LOCALIZE[13396]</value>
		<value>$VAR[OSDHelpTextVar]</value>
	</variable>
	<include name="NaraMusicOSDButton">
