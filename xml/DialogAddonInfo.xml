<?xml version="1.0" encoding="utf-8"?>
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<onload condition="!ListItem.Property(addon.isinstalled) + Window.IsActive(addonbrowser)">SetFocus(6)</onload>
	<onload>SetProperty(infobackground,$ESCINFO[ListItem.Art(fanart)],home)</onload>
	<onunload>ClearProperty(infobackground,home)</onunload>
	<controls>
		<!-- 全屏遮罩 -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="overlay_medium">colors/black.png</texture>
		</control>

		<!-- 标题条 (绝对坐标: 60,100 - 1860,190) -->
		<control type="group">
			<left>60</left>
			<top>100</top>
			<width>1800</width>
			<height>90</height>
			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1800</width>
				<height>90</height>
				<texture material="glass" glassstyle="regular" cornerradius="16">colors/white.png</texture>
			</control>
			<control type="label">
				<left>80</left>
				<top>0</top>
				<width>1300</width>
				<height>90</height>
				<label>$INFO[ListItem.AddonName]</label>
				<font>font52_title</font>
				<aligny>center</aligny>
				<textcolor>text_primary</textcolor>
			</control>
			<control type="label">
				<right>80</right>
				<top>0</top>
				<width>520</width>
				<height>90</height>
				<label>$INFO[ListItem.AddonCreator]</label>
				<align>right</align>
				<aligny>center</aligny>
				<font>font27_narrow</font>
				<textcolor>text_secondary</textcolor>
			</control>
		</control>

		<!-- 大玻璃背景 (绝对坐标: 60,205 - 1860,825) -->
		<control type="image">
			<left>60</left>
			<top>205</top>
			<width>1800</width>
			<height>620</height>
			<texture material="glass" glassstyle="regular" cornerradius="16">colors/white.png</texture>
		</control>

		<!-- 左侧图标区 (缩小50% 左上对齐, 绝对坐标: 80,235 - 320,475) -->
		<control type="group">
			<include>OpenClose_Left</include>
			<left>80</left>
			<top>235</top>
			<control type="image">
				<left>-3</left>
				<top>2</top>
				<width>240</width>
				<height>240</height>
				<aspectratio>scale</aspectratio>
				<include condition="$EXP[nara_dialog_glass]">NaraDialogGlassTexture</include>
				<include condition="!$EXP[nara_dialog_glass]" content="NaraDialogLegacyTexture">
					<param name="texture" value="dialogs/dialog-bg-nobo.png" />
					<param name="shadow" value="true" />
				</include>
			</control>
			<control type="image">
				<left>5</left>
				<top>10</top>
				<width>224</width>
				<height>224</height>
				<aspectratio aligny="top">scale</aspectratio>
				<fadetime>300</fadetime>
				<texture fallback="DefaultAddon.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
			</control>
			<control type="group">
				<visible>String.IsEqual(ListItem.AddonLifecycleType,$LOCALIZE[24170]) | String.IsEqual(ListItem.AddonLifecycleType,$LOCALIZE[24171])</visible>
				<control type="image">
					<left>5</left>
					<top>10</top>
					<width>224</width>
					<height>224</height>
					<texture colordiffuse="overlay_medium">colors/black.png</texture>
				</control>
				<control type="textbox">
					<left>15</left>
					<top>10</top>
					<width>204</width>
					<height>224</height>
					<align>center</align>
					<aligny>center</aligny>
					<label>$VAR[AddonLifecycleType]</label>
					<font>font32_title</font>
				</control>
			</control>
		</control>

		<!-- 右侧内容区 -->
		<control type="group">
			<include>OpenClose_Right</include>

			<!-- 详情字段 (类别/原始/版本号, 图标右侧, id 5000) -->
			<control type="list" id="5000">
				<left>350</left>
				<top>240</top>
				<width>1090</width>
				<height>150</height>
				<onleft>5000</onleft>
				<onright>5000</onright>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<itemlayout height="46">
					<control type="label">
						<left>10</left>
						<top>0</top>
						<width>170</width>
						<height>46</height>
						<aligny>center</aligny>
						<align>right</align>
						<font>font27_narrow</font>
						<label>$INFO[ListItem.Label,[COLOR text_secondary],[/COLOR]]</label>
					</control>
					<control type="label">
						<left>180</left>
						<top>0</top>
						<width>900</width>
						<height>46</height>
						<aligny>center</aligny>
						<font>font27_narrow</font>
						<label>$INFO[ListItem.Label2]</label>
					</control>
				</itemlayout>
				<focusedlayout height="46">
					<control type="label">
						<left>10</left>
						<top>0</top>
						<width>170</width>
						<height>46</height>
						<aligny>center</aligny>
						<align>right</align>
						<font>font27_narrow</font>
						<label>$INFO[ListItem.Label,[COLOR text_secondary],[/COLOR]]</label>
					</control>
					<control type="label">
						<left>180</left>
						<top>0</top>
						<width>900</width>
						<height>46</height>
						<aligny>center</aligny>
						<font>font27_narrow</font>
						<label>$INFO[ListItem.Label2]</label>
						<scroll>false</scroll>
					</control>
				</focusedlayout>
				<content>
					<item>
						<label>$LOCALIZE[21866]:</label>
						<label2>$INFO[ListItem.AddonType]</label2>
						<visible>!String.IsEmpty(ListItem.AddonType)</visible>
					</item>
					<item>
						<label>$LOCALIZE[31150]:</label>
						<label2>$INFO[ListItem.AddonOrigin]</label2>
						<visible>!String.IsEmpty(ListItem.AddonOrigin)</visible>
					</item>
					<item>
						<label>$LOCALIZE[24069]:</label>
						<label2>$INFO[ListItem.AddonVersion]</label2>
						<visible>!String.IsEmpty(ListItem.AddonVersion)</visible>
					</item>
				</content>
			</control>

			<!-- 描述区 -->
			<control type="label">
				<left>80</left>
				<top>500</top>
				<width>320</width>
				<height>35</height>
				<aligny>center</aligny>
				<font>font27_narrow</font>
				<textcolor>text_secondary</textcolor>
				<label>描述：</label>
			</control>
			<control type="textbox">
				<left>80</left>
				<top>535</top>
				<width>1700</width>
				<height>105</height>
				<label>$INFO[ListItem.AddonDescription]</label>
				<autoscroll delay="5000" repeat="7500" time="5000">true</autoscroll>
				<textcolor>text_primary</textcolor>
			</control>

			<!-- 新闻区 -->
			<control type="label">
				<left>80</left>
				<top>660</top>
				<width>320</width>
				<height>35</height>
				<aligny>center</aligny>
				<font>font27_narrow</font>
				<textcolor>text_secondary</textcolor>
				<label>新闻：</label>
			</control>
			<control type="textbox">
				<left>80</left>
				<top>695</top>
				<width>1700</width>
				<height>105</height>
				<label>$INFO[ListItem.AddonNews]</label>
				<autoscroll delay="5000" repeat="7500" time="5000">true</autoscroll>
				<textcolor>text_primary</textcolor>
			</control>
		</control>

		<!-- 按钮条玻璃 (绝对坐标: 60,835 - 1860,980) -->
		<control type="image">
			<left>60</left>
			<top>835</top>
			<width>1800</width>
			<height>145</height>
			<texture material="glass" glassstyle="regular" cornerradius="16">colors/white.png</texture>
		</control>
		<!-- 按钮条 (透明 grouplist，浮在玻璃上) -->
		<control type="grouplist" id="9000">
			<left>60</left>
			<top>835</top>
			<width>1800</width>
			<height>145</height>
			<onleft>9000</onleft>
			<onright>9000</onright>
			<onup>5000</onup>
			<ondown>9000</ondown>
			<align>center</align>
			<itemgap>-8</itemgap>
			<orientation>horizontal</orientation>
			<include content="InfoDialogButton">
				<param name="width" value="264" />
				<param name="id" value="12" />
				<param name="icon" value="icons/infodialogs/launch.png" />
				<param name="label" value="$LOCALIZE[518]" />
			</include>
			<include content="InfoDialogButton">
				<param name="width" value="264" />
				<param name="id" value="9" />
				<param name="icon" value="icons/infodialogs/configure.png" />
				<param name="label" value="$LOCALIZE[24020]" />
			</include>
			<control type="radiobutton" id="13">
				<width>264</width>
				<height>140</height>
				<align>center</align>
				<aligny>top</aligny>
				<textoffsetx>35</textoffsetx>
				<textoffsety>76</textoffsety>
				<radioposx>82</radioposx>
				<radioposy>17</radioposy>
				<radiowidth>100</radiowidth>
				<font>font12</font>
				<hitrect x="21" y="21" w="219" h="100" />
				<visible>Control.IsEnabled(13)</visible>
				<texturefocus cornerradius="18" cornerinset="8" colordiffuse="glass_focus_light">colors/white.png</texturefocus>
				<texturenofocus condition="$EXP[nara_dialog_glass]" />
				<texturenofocus border="21" condition="!$EXP[nara_dialog_glass]">buttons/button-nofo.png</texturenofocus>
				<focusedcolor>$VAR[NaraDialogFocusForegroundVar]</focusedcolor>
				<textureradioonfocus colordiffuse="$VAR[NaraDialogFocusForegroundVar]">buttons/radio-button-on.png</textureradioonfocus>
				<textureradioofffocus colordiffuse="$VAR[NaraDialogFocusForegroundVar]">buttons/radio-button-off.png</textureradioofffocus>
			</control>
			<include content="InfoDialogButton">
				<param name="width" value="264" />
				<param name="id" value="10" />
				<param name="icon" value="icons/infodialogs/info.png" />
				<param name="label" value="$LOCALIZE[39024]" />
			</include>
			<include content="InfoDialogToggleButton">
				<param name="width" value="264" />
				<param name="id" value="7" />
				<param name="icon_on" value="icons/infodialogs/disable.png" />
				<param name="icon_off" value="icons/infodialogs/enabled.png" />
				<param name="selected" value="!String.StartsWith(Control.GetLabel(7),$LOCALIZE[24022]) | !Window.IsActive(addonbrowser)" />
				<param name="label" value="" />
			</include>
			<include content="InfoDialogButton">
				<param name="width" value="264" />
				<param name="id" value="8" />
				<param name="icon" value="icons/infodialogs/install.png" />
				<param name="label" value="$LOCALIZE[24138]" />
			</include>
			<include content="InfoDialogButton">
				<param name="width" value="264" />
				<param name="id" value="14" />
				<param name="icon" value="icons/infodialogs/update.png" />
				<param name="label" value="$LOCALIZE[24069]" />
			</include>
			<include content="InfoDialogToggleButton">
				<param name="width" value="264" />
				<param name="id" value="6" />
				<param name="icon_on" value="icons/infodialogs/uninstall.png" />
				<param name="icon_off" value="icons/infodialogs/install.png" />
				<param name="selected" value="ListItem.Property(addon.isinstalled) | !Window.IsActive(addonbrowser)" />
				<param name="label" value="" />
			</include>
		</control>
	</controls>
</window>
